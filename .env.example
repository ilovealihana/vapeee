BOT_TOKEN=your_telegram_bot_token_here

# PostgreSQL
POSTGRES_USER=vapebot
POSTGRES_PASSWORD=vapebot_secret
POSTGRES_DB=vapebot
DATABASE_URL=postgresql+asyncpg://vapebot:vapebot_secret@localhost:5432/vapebot

# Redis
REDIS_URL=redis://localhost:6379/0

# Admin Telegram IDs (comma-separated)
ADMIN_IDS=123456789,987654321

# InPost delivery cost (PLN)
INPOST_DELIVERY_COST=15.00

# Support Telegram username (without @)
SUPPORT_USERNAME=your_support_username

# Webhook (production). Leave empty for polling (dev).
WEBHOOK_HOST=
WEBHOOK_PATH=/webhook
WEBHOOK_PORT=8443

# Mini App frontend URL (Vercel deployment)
WEBAPP_URL=https://your-vapeshop.vercel.app
